---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke={name === 'github' || name === 'x' || name === 'rss' ? 'none' : 'currentColor'}
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name] ?? ''}
/>
