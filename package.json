{
  "name": "lingze-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "令则的工具、程序分析与技术写作。Markdown 内容保留在 docs/。",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check": "npm test && npm run build && npm run check:site && npm run check:a11y",
    "refresh:github": "node scripts/refresh-github.mjs",
    "comments": "node scripts/comments.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/newsreader": "^5.2.8",
    "astro": "^7.4.7",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "lighthouse": "^13.0.1",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5"
  }
}
